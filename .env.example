# Канонический домен сайта. Используется в sitemap, robots, structured data,
# canonical-метках и /api/call URL. Если не задан — на Vercel автоматически
# берётся VERCEL_PROJECT_PRODUCTION_URL, иначе фоллбэк на medskill.com.kg.
SITE_URL=

# Контакты. Если не заданы — берутся дефолты из src/config/contacts.ts.
# Формат телефона: международный без пробелов и скобок, например +996700333636.
PHONE_PRIMARY=
PHONE_SECONDARY=
PHONE_TERTIARY=
WHATSAPP_NUMBER=
TELEGRAM_LINK=
INSTAGRAM_LINK=
ADDRESS_LINE=
CITY=
COUNTRY_CODE_ISO=
ADDRESS_MAP_URL=
ADDRESS_LAT=
ADDRESS_LNG=

# Telegram-бот для получения заявок с формы на сайте.
# Реальные значения хранятся в .env.local (не в git) и в env переменных хостинга.
#
# Как получить:
# 1. TELEGRAM_BOT_TOKEN — создаётся через @BotFather в Telegram (команда /newbot)
# 2. TELEGRAM_CHAT_ID — id группы/чата, куда падают заявки.
#    Добавьте бота в группу как админа, напишите @<botname> упоминание,
#    затем откройте https://api.telegram.org/bot<TOKEN>/getUpdates — chat.id из результата.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
